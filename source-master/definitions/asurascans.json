{
  "schemaVersion": "1.0",
  "sourceDefinitionKind": "curated_source_config",
  "id": "asurascans",
  "sourceId": "asurascans",
  "name": "Asura Scans",
  "displayName": "Asura Scans",
  "version": "1.0.1",
  "connectorEngine": "selector",
  "sourceType": "selector",
  "base_url": "https://asurascans.com",
  "baseUrl": "https://asurascans.com",
  "language": "en",
  "region": "global",
  "nsfw": false,
  "adultContent": false,
  "description": "Asura Scans public comic catalog using its current server-rendered browse, series and chapter pages.",
  "tags": [
    "Manhwa",
    "Manga",
    "Curated"
  ],
  "appStoreSafe": true,
  "containsExecutableCode": false,
  "requiresExternalBridge": false,
  "rate_limit_ms": 1200,
  "rateLimit": {
    "minDelayMs": 1200,
    "requestsPerMinute": 50
  },
  "downloadPolicy": {
    "transport": "automatic",
    "maximumConcurrentPages": 1,
    "maximumAttempts": 4
  },
  "endpoints": {
    "search": {
      "url": "{base}/browse?q={query}&page={page}",
      "method": "GET"
    },
    "popular": {
      "url": "{base}/browse?sort=popular&page={page}",
      "method": "GET"
    },
    "latest": {
      "url": "{base}/browse?sort=update&page={page}",
      "method": "GET"
    },
    "details": {
      "url": "{base}/comics/{id}",
      "method": "GET"
    },
    "chapters": {
      "url": "{base}/comics/{id}",
      "method": "GET"
    },
    "pages": {
      "url": "{chapter_url}",
      "method": "GET"
    }
  },
  "selectors": {
    "manga_list": {
      "container": "astro-island #series-grid .series-card",
      "title": "h3@text",
      "cover": "img@src",
      "link": "a[href^='/comics/']@href"
    },
    "manga_details": {
      "title": "h1@text",
      "cover": "meta[property='og:image']@content",
      "description": "#description-text@text",
      "authors": "a[href*='?author=']@text",
      "artists": "a[href*='?artist=']@text",
      "genres": "a[href*='?genres=']@text"
    },
    "chapter_list": {
      "container": "a.group[href*='/chapter/']",
      "title": "span.font-medium@text",
      "link": "a@href",
      "number_regex": "(?i)chapter[\\s/]*([0-9]+(?:\\.[0-9]+)?)"
    },
    "page_list": {
      "container": "body",
      "image": "div[data-page] img[data-page-index]@src",
      "exclude": [
        ".svg",
        "logo",
        "icon"
      ]
    }
  },
  "capabilities": {
    "search": true,
    "browse": true,
    "details": true,
    "chapters": true,
    "pages": true,
    "filters": false,
    "pagination": true,
    "imagePages": true,
    "textPages": false,
    "browserVerification": true,
    "listings": [
      "popular",
      "latest"
    ]
  },
  "provenance": {
    "ecosystem": "yomira",
    "originalSourcePath": "sources/asurascans.json",
    "verificationDate": "2026-09-16",
    "configurationEvidence": [
      "https://asurascans.com/browse",
      "https://asurascans.com/comics/solo-leveling-6f7fe6eb"
    ],
    "notes": "Preserves legacy asurascans source identity. Public chapters only; no account, coin or subscription access."
  },
  "pagination": {
    "param": "page",
    "start": 1
  },
  "browserVerificationRequired": true,
  "sessionDomains": [
    "asurascans.com",
    "cdn.asurascans.com"
  ],
  "flags": {
    "is_madara": false,
    "requires_js": false,
    "uses_cloudflare": true
  }
}
