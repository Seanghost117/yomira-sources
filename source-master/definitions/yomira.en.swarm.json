{
  "schemaVersion": "1.0",
  "sourceDefinitionKind": "curated_source_config",
  "id": "yomira.en.swarm",
  "sourceId": "yomira.en.swarm",
  "name": "Swarm",
  "displayName": "Swarm",
  "version": "1.0.0",
  "connectorEngine": "selector",
  "sourceType": "selector",
  "base_url": "https://swarm.ws",
  "baseUrl": "https://swarm.ws",
  "language": "en",
  "region": "en",
  "nsfw": true,
  "adultContent": true,
  "tags": [
    "Curated",
    "Manga",
    "Manhwa"
  ],
  "appStoreSafe": true,
  "containsExecutableCode": false,
  "requiresExternalBridge": false,
  "flags": {
    "requires_js": false,
    "uses_cloudflare": false
  },
  "rate_limit_ms": 1100,
  "rateLimit": {
    "minDelayMs": 1100,
    "requestsPerMinute": 50
  },
  "headers": {
    "Referer": "https://swarm.ws/"
  },
  "capabilities": {
    "search": true,
    "browse": true,
    "details": true,
    "chapters": true,
    "pages": true,
    "filters": false,
    "pagination": true,
    "imagePages": true,
    "textPages": false,
    "browserVerification": false,
    "listings": [
      "popular",
      "latest"
    ]
  },
  "presentation": {
    "primaryListing": "popular",
    "sections": [
      "popular",
      "latest"
    ]
  },
  "description": "Swarm English catalog and provider uploads with native reader request encoding. The upstream chapter API exposes at most the newest 10,000 total uploads for a title; older chapter history may be unavailable.",
  "endpoints": {
    "search": {
      "url": "{base}/api/comic/search?title={query}&limit=24&nsfw=false&suggestive=false",
      "method": "GET"
    },
    "popular": {
      "url": "{base}/api/analytics/popular?window=all&limit=24",
      "method": "GET"
    },
    "latest": {
      "url": "{base}/api/manga/filtered?order=last_updated&nsfw=false&limit=24",
      "method": "GET"
    },
    "details": {
      "url": "https://api.swarm.ws/api/manga/{id}",
      "method": "GET"
    },
    "chapters": {
      "url": "https://api.swarm.ws/api/chapter?manga={id}&limit=10000",
      "method": "GET"
    },
    "pages": {
      "url": "{chapter_url}",
      "method": "GET"
    }
  },
  "selectors": {
    "manga_list": {
      "container": ".yomira-json-list-fallback",
      "title": "a@text",
      "cover": "img@src",
      "link": "a@href"
    },
    "manga_details": {
      "title": "h1@text",
      "cover": "img@src",
      "description": ".description@text",
      "authors": ".author@text",
      "genres": ".genres@text",
      "status": ".status@text"
    },
    "chapter_list": {
      "container": ".yomira-json-chapter-fallback",
      "title": "a@text",
      "link": "a@href"
    },
    "page_list": {
      "container": ".yomira-json-page-fallback",
      "image": "img@src"
    }
  },
  "pagination": {
    "param": "offset",
    "start": 0,
    "step": 24
  },
  "provenance": {
    "ecosystem": "yomira",
    "originalFamily": "Selector",
    "originalLanguage": "en",
    "originalSourceName": "Swarm",
    "analyzerBucket": "curated_selector_profile"
  },
  "downloadPolicy": {
    "transport": "foregroundCore",
    "maximumConcurrentPages": 1,
    "maximumAttempts": 4,
    "minimumDelayMs": 1100
  }
}
