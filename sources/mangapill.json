{
  "id": "mangapill",
  "name": "MangaPill",
  "version": "1.2.1",
  "base_url": "https://mangapill.com",
  "language": "en",
  "nsfw": false,
  "description": "Clean, fast manga reader with a large English catalog and chapter-based navigation",
  "tags": ["Manga", "Free", "Aggregator"],
  "flags": {
    "is_madara": false,
    "requires_js": false,
    "uses_cloudflare": false
  },
  "endpoints": {
    "search": {
      "url": "{base}/search?q={query}",
      "method": "GET"
    },
    "popular": {
      "url": "{base}/",
      "method": "GET"
    },
    "latest": {
      "url": "{base}/chapters",
      "method": "GET"
    },
    "details": {
      "url": "{base}/manga/{id}",
      "method": "GET"
    },
    "chapters": {
      "url": "{base}/manga/{id}",
      "method": "GET"
    },
    "pages": {
      "url": "{chapter_url}",
      "method": "GET"
    }
  },
  "selectors": {
    "manga_list": {
      "container": ".my-3.grid.justify-end > div, .grid.justify-end > div, .grid.grid-cols-2 > div",
      "title": "a[href^='/manga/'] div@text || a[href^='/manga/'] img@alt || a[href^='/manga/']@text",
      "cover": "a[href^='/manga/'] figure img@data-src || a[href^='/manga/'] img@data-src || a[href^='/manga/'] img@src || img@data-src || img@src",
      "link": "a[href^='/manga/']@href"
    },
    "manga_details": {
      "title": "h1@text",
      "cover": "img[alt]@data-src || img[alt]@src || figure img@data-src || figure img@src",
      "description": "p.text--secondary@text || .text-sm.text--secondary@text || div.limit-html p@text",
      "genres": "a[href*='/genre/']@text || a[href*='/type/']@text",
      "status": "label.text-secondary@text || .badge@text"
    },
    "chapter_list": {
      "container": "#chapters a[href*='/chapters/']",
      "title": "a@title || a@text",
      "link": "a@href",
      "date": "",
      "number_regex": "(?i)chapter[\\s/\\-_]*([0-9]+(?:\\.[0-9]+)?)|/chapter[s]?/([0-9]+(?:\\.[0-9]+)?)"
    },
    "page_list": {
      "container": "main",
      "image": "img.js-page@data-src || img.js-page@src || chapter-page img@data-src || chapter-page img@src",
      "exclude": [".svg", "logo", "icon"]
    }
  }
}
